---
import '../styles/global.css';
import site from '../data/site.json';
import { img, abs } from '../lib/img';
import { businessSchema } from '../lib/schema';
import SocialLinks from '../components/SocialLinks.astro';
import pages from '../data/pages.json';
const S: any = site;
const T = S.theme || {};
const themeCss = `:root:root{${T.primary ? `--gold:${T.primary};` : ''}${T.primaryDark ? `--gold-d:${T.primaryDark};` : ''}${T.ink ? `--ink:${T.ink};` : ''}${T.paper ? `--paper:${T.paper};` : ''}--accent-light:${T.accentLight || '#e7c98a'}}`;

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: object[];
  noindex?: boolean;
  type?: 'website' | 'article';
}
const { title, description, image, schema = [], noindex = false, type = 'website' } = Astro.props;
const base = (Astro.site ?? new URL('https://example.com')).toString();
const canonical = new URL(Astro.url.pathname, base).toString();
const ogImg = abs(img(image || site.ogImage, 'full'), Astro.site);
const fullTitle = title.includes(S.brandShort || site.name) ? title : `${title}｜${site.name}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: '首頁' },
  { href: '/about/', label: pages.labels.about },
  { href: '/services/', label: pages.labels.services },
  { href: '/cases/', label: pages.labels.cases },
  { href: '/blog/', label: pages.labels.blog },
  { href: '/faq/', label: pages.labels.faq },
  { href: '/contact/', label: pages.labels.contact },
];
const active = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const schemas = [businessSchema(base), ...schema];
const floatFb = ((site as any).social?.facebook || '').replace(/#$/, '');
const floatMap = (site as any).social?.googleBusiness || (site as any).mapUrl || '';
---
<!doctype html>
<html lang="zh-Hant-TW">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta property="og:type" content={type} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content="zh_TW" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImg} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content={T.ink || "#2b2622"} />
  <style set:html={themeCss}></style>
  <link rel="icon" href={(site as any).favicon || img(site.logoSquare, 'sm')} />
  <link rel="apple-touch-icon" href={img(site.logoSquare, 'sm')} />
  <link rel="sitemap" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM summary" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preconnect" href="https://images.unsplash.com" />
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&family=Noto+Serif+TC:wght@600;700;900&display=swap" rel="stylesheet" />
  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  {site.tracking?.googleVerification && <meta name="google-site-verification" content={site.tracking.googleVerification} />}
  {site.tracking?.bingVerification && <meta name="msvalidate.01" content={site.tracking.bingVerification} />}
  {site.tracking?.gtmId && /^GTM-[A-Z0-9]+$/.test(site.tracking.gtmId) && (
    <script is:inline define:vars={{ gtm: site.tracking.gtmId }}>
      (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtm);
    </script>
  )}
  {site.tracking?.ga4Id && /^G-[A-Z0-9]+$/.test(site.tracking.ga4Id) && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.tracking.ga4Id}`}></script>
      <script is:inline define:vars={{ ga4: site.tracking.ga4Id }}>
        window.dataLayer = window.dataLayer || []; window.gtag = function(){ window.dataLayer.push(arguments); }; window.gtag('js', new Date()); window.gtag('config', ga4);
      </script>
    </>
  )}
  {(site.tracking?.ga4Id || site.tracking?.gtmId) && (
    <script is:inline>
      // GA4／GTM 事件追蹤（事件名稱與參數說明見 README「GA4 事件」）
      (function () {
        window.dataLayer = window.dataLayer || [];
        var pageType = (location.pathname.split('/')[1] || 'home');
        window.fzjTrack = function (name, params) {
          params = Object.assign({ page_type: pageType }, params || {});
          window.dataLayer.push(Object.assign({ event: name }, params));          // GTM 用
          if (typeof window.gtag === 'function') window.gtag('event', name, Object.assign({ transport_type: 'beacon' }, params)); // GA4 直接送
        };
        function where(el) {
          var map = [['.float-cta', 'float'], ['.site-header', 'header'], ['.site-footer', 'footer'], ['.cta-band', 'cta_band'],
                     ['.hero', 'hero'], ['.side-card', 'sidebar'], ['.share', 'share_bar']];
          for (var i = 0; i < map.length; i++) if (el.closest(map[i][0])) return map[i][1];
          return pageType === 'contact' ? 'contact_page' : 'content';
        }
        document.addEventListener('click', function (e) {
          var t = e.target; if (!t || !t.closest) return;
          // 分享按鈕
          var sh = t.closest('.share a, .share button');
          if (sh) {
            var m = sh.classList.contains('share-copy') ? 'copy_link' : /facebook/.test(sh.href) ? 'facebook' : /line\.me/.test(sh.href) ? 'line' : /threads/.test(sh.href) ? 'threads' : 'other';
            return window.fzjTrack('share', { method: m, content_type: pageType, item_id: location.pathname });
          }
          // 案例照片放大
          var ph = t.closest('[data-gallery] a');
          if (ph) return window.fzjTrack('view_case_photo', { item_id: location.pathname });
          // 案例分類篩選
          var fl = t.closest('.filters a');
          if (fl) return window.fzjTrack('filter_cases', { filter_category: fl.dataset.f || fl.textContent.trim() });
          var a = t.closest('a'); if (!a || !a.href) return;
          var loc = where(a), text = (a.getAttribute('aria-label') || a.textContent || '').trim().slice(0, 40);
          // 聯絡轉換（主要事件）
          var ev = /line\.me/.test(a.href) ? 'line_click' : /^tel:/.test(a.href) ? 'phone_click'
                 : /facebook\.com/.test(a.href) ? 'fb_click'
                 : /(google\.[a-z.]+\/maps|maps\.app\.goo\.gl|goo\.gl\/maps)/.test(a.href) ? 'map_click' : '';
          if (ev) return window.fzjTrack(ev, { click_location: loc, link_url: a.href.slice(0, 100), link_text: text });
          // 站內按鈕（看案例、看服務、關於我們…）
          if (a.classList.contains('btn') && a.host === location.host)
            return window.fzjTrack('cta_click', { click_location: loc, link_url: a.pathname, link_text: text });
        });
        // 常見問題展開（看哪些問題最多人關心）
        document.addEventListener('toggle', function (e) {
          var d = e.target;
          if (d && d.tagName === 'DETAILS' && d.open && d.closest('.faq')) {
            var q = d.querySelector('summary');
            window.fzjTrack('faq_open', { faq_question: q ? q.textContent.trim().slice(0, 90) : '' });
          }
        }, true);
      })();
    </script>
  )}
  <slot name="head" />
</head>
<body>
  {site.tracking?.gtmId && /^GTM-[A-Z0-9]+$/.test(site.tracking.gtmId) && (
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${site.tracking.gtmId}`} height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  )}
  <a class="skip" href="#main">跳到主要內容</a>
  <header class="site-header">
    <div class="wrap header-inner">
      <a href="/" class="brand" aria-label={`${site.name} 首頁`}>
        <img src={img(site.logo)} alt={`${site.name} 標誌`} width="180" height="60" />
      </a>
      <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="開啟選單" />
      <label for="nav-toggle" class="nav-btn" aria-hidden="true"><span></span></label>
      <nav class="main-nav" aria-label="主選單">
        <ul>
          {nav.map((n) => <li><a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a></li>)}
        </ul>
        <a class="btn btn-gold nav-cta" href={site.lineUrl} target="_blank" rel="noopener">{pages.labels.ctaNav}</a>
      </nav>
    </div>
  </header>

  <main id="main"><slot /></main>

  <footer class="site-footer">
    <div class="wrap footer-grid">
      <div>
        {(site as any).logoStacked
          ? <img src={img((site as any).logoStacked)} alt="" width="200" height="145" loading="lazy" class="footer-logo footer-logo-stacked" />
          : <img src={img(site.logoSquare, 'sm')} alt="" width="88" height="88" loading="lazy" class="footer-logo" />}
        <p class="footer-brand">{site.name}</p>
        <p class="muted">{site.slogan}</p>
        <SocialLinks size={34} tone="light" />
      </div>
      <div>
        <h2 class="footer-h">聯絡資訊</h2>
        <ul class="plain">
          <li>負責人：{site.owner}</li>
          <li>電話：<a href={`tel:${site.phoneRaw}`}>{site.phone}</a></li>
          <li>LINE：<a href={site.lineUrl} target="_blank" rel="noopener">{site.lineId}</a></li>
          <li>地址：<a href={site.mapUrl} target="_blank" rel="noopener">{site.address.full}</a></li>
          {site.hours && <li>時間：{site.hours}</li>}
          <li>服務區域：{site.areas.join('、')}</li>
        </ul>
      </div>
      <div>
        <h2 class="footer-h">網站導覽</h2>
        <ul class="plain cols2">
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </div>
    </div>
    <div class="wrap copyright">© {new Date().getFullYear()} {site.legalName}. All rights reserved.</div>
  </footer>

  <div class="float-cta" aria-label="快速聯絡">
    {floatMap && (
      <a href={floatMap} target="_blank" rel="noopener" class="fc fc-map" aria-label="查看地圖與導航">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7zm0 9.6A2.6 2.6 0 1 1 12 6.4a2.6 2.6 0 0 1 0 5.2z"/></svg>
        <span>地圖</span>
      </a>
    )}
    {floatFb && (
      <a href={floatFb} target="_blank" rel="noopener" class="fc fc-fb" aria-label="Facebook 粉絲專頁">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1z"/></svg>
        <span>Facebook</span>
      </a>
    )}
    <a href={`tel:${site.phoneRaw}`} class="fc fc-phone" aria-label="撥打電話">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1A17 17 0 0 1 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.5.6 3.6.1.3 0 .7-.2 1l-2.3 2.2z"/></svg>
      <span>電話</span>
    </a>
    <a href={site.lineUrl} target="_blank" rel="noopener" class="fc fc-line" aria-label="加 LINE 諮詢">
      <svg class="line-icon" viewBox="0 0 48 48" aria-hidden="true"><path fill="#fff" d="M24 8C14.1 8 6 14.5 6 22.6c0 7.2 6.4 13.3 15.1 14.4.6.1 1.4.4 1.6.9.2.5.1 1.2.1 1.6l-.3 1.6c-.1.5-.4 1.8 1.6 1 2-.8 10.6-6.3 14.5-10.8C41.3 28.3 42 25.6 42 22.6 42 14.5 33.9 8 24 8z"/><text x="24" y="26.2" text-anchor="middle" font-family="Arial, Helvetica, sans-serif" font-weight="900" font-size="9.2" fill="#06c755" letter-spacing=".2">LINE</text></svg>
      <span>LINE</span>
    </a>
  </div>
</body>
</html>
