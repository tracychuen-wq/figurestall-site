---
// 社群圖示：只顯示有填網址的平台（後台「公司基本資料 → 社群帳號」設定）
import site from '../data/site.json';
interface Props { size?: number; label?: boolean; tone?: 'light' | 'dark' }
const { size = 40, label = false, tone = 'dark' } = Astro.props;
const s: Record<string, string> = (site as any).social || {};
const ICON: Record<string, string> = {
