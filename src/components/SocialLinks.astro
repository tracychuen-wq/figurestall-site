  line: '<path d="M12 3C6.5 3 2 6.6 2 11c0 4 3.5 7.3 8.3 7.9.3.1.8.2.9.5.1.3.1.7 0 1l-.1.9c0 .3-.2 1 .9.5 1.1-.4 5.9-3.5 8-6C21.3 14.3 22 12.7 22 11c0-4.4-4.5-8-10-8z"/>',
};
const NAME: Record<string, string> = { facebook: 'Facebook', instagram: 'Instagram', threads: 'Threads', youtube: 'YouTube', tiktok: 'TikTok', googleBusiness: 'Google 商家', line: 'LINE' };
const COLOR: Record<string, string> = { facebook: '#1877f2', instagram: '#e4405f', threads: '#111', youtube: '#ff0000', tiktok: '#111', googleBusiness: '#4285f4', line: '#06c755' };
const items = [...Object.keys(ICON).filter((k) => k !== 'line' && s[k]).map((k) => [k, s[k]]), ['line', site.lineUrl]].filter(([, u]) => u);
---
<ul class={`social social-${tone}`} aria-label={`${site.brandShort}社群帳號`}>
  {items.map(([k, u]) => (
    <li>
      <a href={u} target="_blank" rel="noopener me" aria-label={`${NAME[k]}（另開新視窗）`} title={NAME[k]} style={`--c:${COLOR[k]};--s:${size}px`}>
        <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON[k]} />
        {label && <span>{NAME[k]}</span>}
      </a>
    </li>
  ))}
</ul>
