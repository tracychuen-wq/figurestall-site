---
import site from '../data/site.json';
interface Props { title?: string; text?: string }
const { title = fill(pages.cta.title), text = fill(pages.cta.text) } = Astro.props;
import pages from '../data/pages.json';
import { fill, rich, md } from '../lib/text';
---
<section class="cta-band">
  <div class="wrap">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="actions">
      <a class="btn btn-line" href={site.lineUrl} target="_blank" rel="noopener">LINE 諮詢 {site.lineId}</a>
      <a class="btn btn-ghost" href={`tel:${site.phoneRaw}`}>撥打 {site.phone}</a>
      {(site as any).shopUrl && <a class="btn btn-ghost" href={(site as any).shopUrl} target="_blank" rel="noopener">{(site as any).shopLabel || '線上下單'}</a>}
    </div>
  </div>
</section>
