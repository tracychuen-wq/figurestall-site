---
// 分享按鈕：Facebook、LINE、Threads、複製連結
interface Props { title: string }
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const u = encodeURIComponent(url), t = encodeURIComponent(title);
---
<div class="share" aria-label="分享這一頁">
  <span class="share-l">分享：</span>
  <a href={`https://www.facebook.com/sharer/sharer.php?u=${u}`} target="_blank" rel="noopener" style="--c:#1877f2">Facebook</a>
  <a href={`https://social-plugins.line.me/lineit/share?url=${u}`} target="_blank" rel="noopener" style="--c:#06c755">LINE</a>
  <a href={`https://www.threads.net/intent/post?text=${t}%20${u}`} target="_blank" rel="noopener" style="--c:#111">Threads</a>
  <button type="button" class="share-copy" data-url={url} style="--c:#8c6c2c">複製連結</button>
</div>
<script>
  document.querySelectorAll<HTMLButtonElement>('.share-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(b.dataset.url || location.href); b.textContent = '已複製 ✓'; }
    catch { prompt('複製這個連結：', b.dataset.url || location.href); }
    setTimeout(() => (b.textContent = '複製連結'), 2000);
  }));
</script>
