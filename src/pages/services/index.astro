---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import { img } from '../../lib/img';
import { breadcrumb } from '../../lib/schema';
import { getCollection } from 'astro:content';
const services = (await getCollection('services', (s) => !s.data.draft)).sort((a, b) => a.data.order - b.data.order);
const base = Astro.site!.toString();
const crumbs = [{ name: '首頁', path: '/' }, { name: pages.labels.services, path: '/services/' }];
const list = { '@context': 'https://schema.org', '@type': 'ItemList', itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, url: new URL(`/services/${s.id}/`, base).toString(), name: s.data.title })) };
import pages from '../../data/pages.json';
import { fill, rich, md } from '../../lib/text';
---
<Base title={fill(pages.services.seoTitle)} description={fill(pages.services.seoDescription)} schema={[breadcrumb(base, crumbs), list]}>
  <section class="page-hero"><div class="wrap"><Crumbs items={crumbs} /><h1>{pages.labels.services}</h1><p>{fill(pages.services.intro)}</p></div></section>
  <section class="block"><div class="wrap">
    {services.map((s, i) => (
      <article class="split" style="margin-bottom:64px">
        <a href={`/services/${s.id}/`} style={i % 2 ? 'order:2' : ''}><img src={img(s.data.cover, 'lg')} alt={s.data.title} loading="lazy" width="800" height="600" /></a>
        <div>
          <h2><a href={`/services/${s.id}/`} style="color:inherit;text-decoration:none">{s.data.title}</a></h2>
          <p>{s.data.summary}</p>
          {s.data.signs.length > 0 && <ul class="muted">{s.data.signs.slice(0, 3).map((x) => <li>{x}</li>)}</ul>}
          <a class="btn btn-ghost" href={`/services/${s.id}/`}>看常見問題與做法</a>
        </div>
      </article>
    ))}
  </div></section>
  <CtaBand />
</Base>
