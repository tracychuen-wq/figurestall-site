---
import Base from '../layouts/Base.astro';
import CaseCard from '../components/CaseCard.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import site from '../data/site.json';
import { img } from '../lib/img';
import { faqSchema } from '../lib/schema';
import { getCollection } from 'astro:content';
import pages from '../data/pages.json';
import { fill, rich, md } from '../lib/text';

const services = (await getCollection('services', (s) => !s.data.draft)).sort((a, b) => a.data.order - b.data.order);
const cases = (await getCollection('cases', (c) => !c.data.draft)).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || +b.data.date - +a.data.date).slice(0, 6);
const posts = (await getCollection('blog', (p) => !p.data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const H = pages.home, L = pages.labels;
const homeFaqs = H.faqs.map((f) => ({ q: fill(f.q), a: fill(f.a) }));
---
<Base
  title={fill(H.seoTitle)}
  description={fill(H.seoDescription)}
  schema={[faqSchema(homeFaqs), { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url: Astro.site?.toString(), inLanguage: 'zh-TW' }]}
>
  <section class="hero">
    <img class="bg" src={img(site.heroImages[0], 'full')} alt={H.heroAlt} width="1920" height="750" fetchpriority="high" />
    <div class="wrap">
      <span class="eyebrow" style="color:var(--accent-light)">{H.eyebrow}</span>
      <h1 set:html={rich(H.h1)} />
      <p class="lead">{fill(H.lead)}</p>
      <div class="actions">
        <a class="btn btn-gold" href={site.lineUrl} target="_blank" rel="noopener">{H.ctaPrimary}</a>
        <a class="btn btn-ghost" href="/cases/">{H.ctaSecondary}</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Services</span><h2>{fill(H.servicesTitle)}</h2></div>
        <a href="/services/" class="btn btn-ghost">全部服務</a>
      </div>
      <div class="grid g3">
        {services.map((s) => (
          <a class="card" href={`/services/${s.id}/`}>
            <div class="thumb"><img src={img(s.data.cover, 'lg')} alt={s.data.title} loading="lazy" width="800" height="600" /></div>
            <div class="body">
              <h3>{s.data.shortTitle}</h3>
              <p>{s.data.summary}</p>
              <span class="more">了解更多 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap split">
      <div>
        <span class="eyebrow">About</span>
        <h2 set:html={rich(H.aboutTitle)} />
        {fill(H.aboutText).split(/\n\s*\n/).map((para) => <p set:html={rich(para)} />)}
        <div class="values">
          {H.values.map((v) => <div><strong>{v.title}</strong><span class="muted">{v.sub}</span></div>)}
        </div>
        <p style="margin-top:24px"><a href="/about/" class="btn btn-ghost">{fill(H.aboutButton)}</a></p>
      </div>
      <img src={img(H.aboutImage, 'lg')} alt={H.aboutImageAlt} loading="lazy" width="800" height="450" />
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head"><div><span class="eyebrow">For You</span><h2 set:html={rich(H.audienceTitle)} /></div></div>
      <ul class="audience" style="padding:0">
        {H.audience.map((a) => (
          <li>{a.icon && <img src={img(a.icon)} alt="" width="56" height="56" loading="lazy" />}<h3>{a.title}</h3><p>{a.desc}</p></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block dark">
    <div class="wrap">
      <span class="eyebrow">Process</span>
      <h2>{fill(H.processTitle)}</h2>
      <ol class="steps">
        {H.steps.map((st) => <li><h3>{st.title}</h3><p>{st.desc}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Cases</span><h2>{L.cases}</h2><p class="muted" style="margin:0">{fill(H.casesSub)}</p></div>
        <a href="/cases/" class="btn btn-ghost">全部案例</a>
      </div>
      <div class="grid g3">{cases.map((c) => <CaseCard c={c} />)}</div>
    </div>
  </section>

  <section class="block alt">
    <div class="wrap">
      <div class="section-head">
        <div><span class="eyebrow">Knowledge</span><h2>{L.blog}</h2></div>
        <a href="/blog/" class="btn btn-ghost">更多文章</a>
      </div>
      <div class="grid g3">{posts.map((p) => <PostCard p={p} />)}</div>
    </div>
  </section>

  <section class="block">
    <div class="wrap narrow">
      <span class="eyebrow">FAQ</span>
      <h2>{fill(H.faqTitle)}</h2>
      <Faq faqs={homeFaqs} />
      <p style="margin-top:20px"><a href="/faq/">{fill(H.faqMore)}</a></p>
    </div>
  </section>

  <CtaBand />
</Base>
