---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Faq from '../../components/Faq.astro';
import PostCard from '../../components/PostCard.astro';
import ShareBar from '../../components/ShareBar.astro';
import site from '../../data/site.json';
import { img } from '../../lib/img';
import { breadcrumb, faqSchema } from '../../lib/schema';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { p } }));
}
const { p } = Astro.props;
const d = p.data;
const { Content, headings } = await render(p);
const base = Astro.site!.toString();
const url = new URL(`/blog/${p.id}/`, base).toString();
const date = d.date.toISOString().slice(0, 10);
const upd = (d.updated ?? d.date).toISOString().slice(0, 10);
const more = (await getCollection('blog', (x) => !x.data.draft && x.id !== p.id)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const crumbs = [{ name: '首頁', path: '/' }, { name: pages.labels.blog, path: '/blog/' }, { name: d.title, path: `/blog/${p.id}/` }];
const article = {
  '@context': 'https://schema.org', '@type': 'BlogPosting', headline: d.title, description: d.summary, url, mainEntityOfPage: url,
  datePublished: date, dateModified: upd, inLanguage: 'zh-TW', keywords: d.tags.join(','),
  image: d.cover ? img(d.cover) : img(site.ogImage),
  author: { '@type': 'Person', name: site.ownerName, alternateName: site.ownerNick, jobTitle: `${site.brandShort} ${site.ownerTitle}` },
  publisher: { '@id': base + '#business' },
};
const toc = headings.filter((h) => h.depth === 2);
import pages from '../../data/pages.json';
import { fill, rich, md } from '../../lib/text';
---
<Base title={d.seoTitle || d.title} description={d.seoDescription || d.summary} image={d.cover} type="article" schema={[breadcrumb(base, crumbs), article, ...(d.faqs.length ? [faqSchema(d.faqs)] : [])]}>
  <section class="page-hero"><div class="wrap narrow">
    <Crumbs items={crumbs} />
    <h1>{d.title}</h1>
    <p class="meta">作者：{site.ownerName}（{site.ownerNick}）・{site.brandShort}｜發布 <time datetime={date}>{date}</time>{upd !== date && <>｜更新 <time datetime={upd}>{upd}</time></>}</p>
  </div></section>
  <section class="block"><div class="wrap layout-side">
    <article>
      {d.keyPoints.length > 0 && <div class="answer-box"><strong class="lbl">重點整理</strong><ul>{d.keyPoints.map((k) => <li>{k}</li>)}</ul></div>}
      {d.cover && <img src={img(d.cover, 'lg')} alt={d.title} width="800" height="450" style="border-radius:6px;margin-bottom:28px" />}
      <div class="prose"><Content /></div>
      {d.faqs.length > 0 && (<><h2 style="margin-top:48px">延伸問答</h2><Faq faqs={d.faqs} /></>)}
      <ShareBar title={d.title} />
    </article>
    <aside>
      {toc.length > 2 && <div class="side-card"><h2>目錄</h2><ol style="padding-left:1.2em;margin:0">{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol></div>}
      <div class="side-card"><h2>{fill(pages.blog.sideTitle)}</h2><p class="muted">{fill(pages.blog.sideText)}</p><a class="btn btn-line" href={site.lineUrl} target="_blank" rel="noopener">LINE {site.lineId}</a></div>
    </aside>
  </div></section>
  <section class="block alt"><div class="wrap"><h2>延伸閱讀</h2><div class="grid g3">{more.map((m) => <PostCard p={m} />)}</div></div></section>
  <CtaBand />
</Base>
