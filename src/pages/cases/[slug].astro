---
import Base from '../../layouts/Base.astro';
import Crumbs from '../../components/Crumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import Gallery from '../../components/Gallery.astro';
import CaseCard from '../../components/CaseCard.astro';
import ShareBar from '../../components/ShareBar.astro';
import site from '../../data/site.json';
import { img } from '../../lib/img';
import { breadcrumb } from '../../lib/schema';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const cases = await getCollection('cases', (c) => !c.data.draft);
  return cases.map((c) => ({ params: { slug: c.id }, props: { c } }));
}
const { c } = Astro.props;
const d = c.data;
const { Content } = await render(c);
const svc = await getEntry('services', d.service);
const base = Astro.site!.toString();
const url = new URL(`/cases/${c.id}/`, base).toString();
const date = d.date.toISOString().slice(0, 10);
const more = (await getCollection('cases', (x) => !x.data.draft && x.id !== c.id)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
const crumbs = [{ name: '首頁', path: '/' }, { name: pages.labels.cases, path: '/cases/' }, { name: d.category, path: `/cases/${c.id}/` }];
const schema = {
  '@context': 'https://schema.org', '@type': 'CreativeWork', name: d.title, headline: d.title, description: d.summary, url,
  datePublished: date, image: d.photos.slice(0, 10).map((p) => img(p.src)), creator: { '@id': base + '#business' }, about: d.category,
  associatedMedia: d.photos.map((p, i) => ({ '@type': 'ImageObject', contentUrl: img(p.src), caption: p.alt || `${d.category} ${i + 1}` })),
};
import pages from '../../data/pages.json';
import { fill, rich, md } from '../../lib/text';
---
<Base title={d.seoTitle || d.title} description={d.seoDescription || d.summary} image={d.cover} schema={[breadcrumb(base, crumbs), schema]}>
  <section class="page-hero"><div class="wrap">
    <Crumbs items={crumbs} />
    <h1>{d.title}</h1>
    <p class="meta">類別：{d.category}{d.location && `｜地點：${d.location}`}｜紀錄日期：<time datetime={date}>{date}</time>｜照片 {d.photos.length} 張</p>
  </div></section>
  <section class="block"><div class="wrap layout-side">
    <div>
      <div class="answer-box"><strong class="lbl">案例摘要</strong>{d.summary}</div>
      <Gallery photos={d.photos} fallbackAlt={d.category} />
      <div class="prose" style="margin-top:36px"><Content /></div>
      <ShareBar title={d.title} />
    </div>
    <aside>
      {svc && <div class="side-card"><h2>相關服務</h2><p class="muted">{svc.data.summary}</p><a class="btn btn-ghost" href={`/services/${svc.id}/`}>{svc.data.shortTitle} Q&amp;A</a></div>}
      <div class="side-card"><h2>{fill(pages.cases.sideTitle)}</h2><a class="btn btn-line" href={site.lineUrl} target="_blank" rel="noopener">LINE 諮詢</a><a class="btn btn-gold" href={`tel:${site.phoneRaw}`}>{site.phone}</a></div>
    </aside>
  </div></section>
  <section class="block alt"><div class="wrap"><h2>更多{pages.labels.cases}</h2><div class="grid g3">{more.map((m) => <CaseCard c={m} />)}</div></div></section>
  <CtaBand />
</Base>
